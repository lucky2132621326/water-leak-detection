# NOTE: this file is a REFERENCE, not auto-loaded. The Python backend does not
# call load_dotenv(), so values here take effect only if you export them into
# your shell (e.g. `export MONGO_URI=...`) before starting uvicorn. Every value
# below already matches the built-in default, so for normal local development
# you do not need to set anything at all.

# MONGO_URI: MongoDB connection string used by the Python backend
# (backend/repositories/db.py). This default is exactly what `docker compose up`
# publishes, so leave it alone unless you remap the port in docker-compose.yml.
MONGO_URI="mongodb://localhost:27017"
MONGO_DB_NAME="water_leak_detection"

# MQTT broker the ESP32 rig publishes telemetry to (backend/mqtt/subscriber.py).
# Started by `docker compose --profile live up -d` (Live Mode only).
MQTT_HOST="localhost"
MQTT_PORT="1883"

# AZURE_OPENAI_*: optional. Used by backend/llm/summary_client.py to generate
# work-order/evidence summaries. If unset, the system falls back to a
# deterministic template — the demo does not depend on these being present.
AZURE_OPENAI_API_KEY=""
AZURE_OPENAI_ENDPOINT=""
AZURE_OPENAI_DEPLOYMENT="gpt-4o-mini"
AZURE_OPENAI_API_VERSION="2024-02-15-preview"

# FASTAPI_BASE_URL: where server.ts proxies /api/telemetry, /api/replay/*,
# /api/localization/*, /api/work-orders*, /api/mode to (backend/api_server.py).
FASTAPI_BASE_URL="http://localhost:8000"
