# MONGO_URI: MongoDB connection string used by the Python backend
# (backend/repositories/db.py). Local dev default: mongodb://localhost:27017
MONGO_URI="mongodb://localhost:27017"
MONGO_DB_NAME="water_leak_detection"

# MQTT broker the ESP32 rig publishes telemetry to (backend/mqtt/subscriber.py).
MQTT_HOST="localhost"
MQTT_PORT="1883"

# AZURE_OPENAI_*: optional. Used by backend/llm/summary_client.py to generate
# work-order/evidence summaries. If unset, the system falls back to a
# deterministic template — the demo does not depend on these being present.
AZURE_OPENAI_API_KEY=""
AZURE_OPENAI_ENDPOINT=""
AZURE_OPENAI_DEPLOYMENT="gpt-4o-mini"
AZURE_OPENAI_API_VERSION="2024-02-15-preview"

# FASTAPI_BASE_URL: where server.ts proxies /api/telemetry, /api/replay/*,
# /api/localization/*, /api/work-orders*, /api/mode to (backend/api_server.py).
FASTAPI_BASE_URL="http://localhost:8001"

# Twilio WhatsApp leak alerts. Never commit real credentials to this file.
# The Content Template should use {{1}} for the suspected zone and {{2}} for
# the event timestamp. Live alerts are enabled only when the flag is true.
TWILIO_WHATSAPP_ENABLED="false"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"
TWILIO_WHATSAPP_TO="whatsapp:+91XXXXXXXXXX"
TWILIO_CONTENT_SID=""
# Variables sent to the approved template. For the literal values in Twilio's
# quick-start example, set these to "12/1" and "3pm" instead.
TWILIO_CONTENT_VARIABLE_1="{zone}"
TWILIO_CONTENT_VARIABLE_2="{event_time}"
# Keep false in normal operation to avoid messaging on looping demo replays.
TWILIO_NOTIFY_REPLAY="false"
TWILIO_TIMEOUT_SEC="8"

# CORS_ALLOWED_ORIGINS: comma-separated origins allowed to call the FastAPI
# service directly (backend/api_server.py). Defaults to the local dashboard
# origin only — the API has unauthenticated mutating routes (mode switch,
# work-order dispatch, ground-truth logging), so this should never be "*".
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# API_KEY: required on every state-changing FastAPI route (mode switch,
# calibration save, ground-truth start/stop, work-order dispatch, alert
# disposition). Must be the SAME value in both the FastAPI process's env
# (backend/api_server.py) and the Node process's env (server.ts, which
# attaches it server-side when proxying — the browser never sees it).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Using the insecure default logs a warning on FastAPI startup.
API_KEY="local-dev-key-change-me"
