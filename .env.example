# Copy this file to .env. The npm development and public-demo launchers load it
# before starting Python and Node. If uvicorn is started directly, export these
# values in that shell because the Python process does not call load_dotenv().

# MONGO_URI: MongoDB connection string used by the Python backend
# (backend/repositories/db.py). This default is exactly what `docker compose up`
# publishes, so leave it alone unless you remap the port in docker-compose.yml.
MONGO_URI="mongodb://localhost:27017"
MONGO_DB_LIVE="jal_netra_live"
MONGO_DB_MOCK="jal_netra_mock"

# MQTT broker the ESP32 rig publishes telemetry to (backend/ingestion/mqtt_source.py).
# Started by `docker compose --profile live up -d` (Live Mode only).
MQTT_HOST="localhost"
MQTT_PORT="1883"
MQTT_USERNAME="rig_backend"
MQTT_PASSWORD=""
MQTT_DEVICE_USERNAME="rig_device"
MQTT_DEVICE_PASSWORD=""
# Safe default. Set this to the laptop's dedicated rig-interface IP only when
# the ESP32 is connected to that isolated/private network. Never use 0.0.0.0.
MQTT_BIND_ADDRESS="127.0.0.1"
MOSQUITTO_HOME=".tools/mosquitto"

# AZURE_OPENAI_*: optional. Used by backend/llm/summary_client.py to generate
# work-order/evidence summaries. If unset, the system falls back to a
# deterministic template — the demo does not depend on these being present.
AZURE_OPENAI_API_KEY=""
AZURE_OPENAI_ENDPOINT=""
AZURE_OPENAI_DEPLOYMENT="gpt-4o-mini"
AZURE_OPENAI_API_VERSION="2024-02-15-preview"

# FASTAPI_BASE_URL: where server.ts proxies backend API routes.
FASTAPI_BASE_URL="http://localhost:8001"

# Twilio WhatsApp leak alerts. Never commit real credentials to this file.
# The Content Template should use {{1}} for the suspected zone and {{2}} for
# the event timestamp. Live alerts are enabled only when the flag is true.
TWILIO_WHATSAPP_ENABLED="false"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"
TWILIO_WHATSAPP_TO="whatsapp:+91XXXXXXXXXX"
TWILIO_CONTENT_SID=""
# Variables sent to the approved template. For the literal values in Twilio's
# quick-start example, set these to "12/1" and "3pm" instead.
TWILIO_CONTENT_VARIABLE_1="{zone}"
TWILIO_CONTENT_VARIABLE_2="{event_time}"
# Keep false in normal operation to avoid messaging on looping demo replays.
TWILIO_NOTIFY_MOCK="false"
TWILIO_TIMEOUT_SEC="8"

# CORS_ALLOWED_ORIGINS: comma-separated origins allowed to call the FastAPI
# service directly (backend/api_server.py). Defaults to the local dashboard
# origin only. Mutating routes also require X-API-Key; this should never be "*".
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# API_KEY: required on every state-changing FastAPI route (mode switch,
# calibration save, ground-truth start/stop, work-order dispatch, alert
# disposition). Must be the SAME value in both the FastAPI process's env
# (backend/api_server.py) and the Node process's env (server.ts, which
# attaches it server-side when proxying — the browser never sees it).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Using the insecure default logs a warning on FastAPI startup.
API_KEY="local-dev-key-change-me"

# Runtime audience. The normal local dashboard is operator mode. The public
# demo launcher starts a second process with DASHBOARD_AUDIENCE=judge, which
# hides controls and rejects every state-changing request before it reaches
# FastAPI.
DASHBOARD_AUDIENCE="operator"
